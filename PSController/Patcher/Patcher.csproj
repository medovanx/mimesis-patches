<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.3.3</Version>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable>
    <AssemblyName>PSControllerPatcher</AssemblyName>
    <Authors>Mohamed Darwesh</Authors><Company>Mohamed Darwesh</Company><Product>MIMESIS PSController Patcher</Product><Copyright>Mohamed Darwesh (github.com/medovanx)</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Common\PatcherCore.cs" Link="Common\%(Filename)%(Extension)" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- Runtime DLL and icons are embedded so the exe is a single file. -->
    <EmbeddedResource Include="..\Runtime\bin\Release\netstandard2.1\PSControllerRuntime.dll" LogicalName="PSControllerRuntime.dll" />
    <EmbeddedResource Include="..\Icons\*.png" LogicalName="icons/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
