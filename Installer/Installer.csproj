<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2.0.0</Version>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable>
    <AssemblyName>MimesisPatchesInstaller</AssemblyName>
    <Authors>Mohamed Darwesh</Authors><Company>Mohamed Darwesh</Company><Product>MIMESIS Patches Installer</Product><Copyright>Mohamed Darwesh (github.com/medovanx)</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the install logic is compiled in; every patch file is downloaded from GitHub releases. -->
    <Compile Include="..\Common\PatcherCore.cs" Link="Common\%(Filename)%(Extension)" />
    <Compile Include="..\BiggerLobby\Patcher\Setup.cs" Link="BiggerLobby\Setup.cs" />
    <Compile Include="..\PSController\Patcher\Setup.cs" Link="PSController\Setup.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
