<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.2.7</Version>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable>
    <AssemblyName>InventoryPatcher</AssemblyName>
    <Authors>Mohamed Darwesh</Authors><Company>Mohamed Darwesh</Company><Product>MIMESIS Inventory Patcher</Product><Copyright>Mohamed Darwesh (github.com/medovanx)</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Common\PatcherCore.cs" Link="Common\%(Filename)%(Extension)" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- Runtime DLL and Harmony are embedded so the exe is a single file. -->
    <EmbeddedResource Include="..\Runtime\bin\Release\net472\InventoryRuntime.dll" LogicalName="InventoryRuntime.dll" />
    <EmbeddedResource Include="..\Runtime\bin\Release\net472\0Harmony.dll" LogicalName="0Harmony.dll" />
  </ItemGroup>
</Project>
