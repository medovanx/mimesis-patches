<Project>
  <!-- Every patch runtime (<Patch>Runtime.dll) is a MelonLoader mod: Common/MelonEntry.cs is its entry point, and it
       uses MelonLoader's own Harmony. The MelonInfo attribute is generated from the project's name and version. -->
  <PropertyGroup Condition="$(AssemblyName.EndsWith('Runtime'))">
    <PatchName>$(AssemblyName.Replace('Runtime', ''))</PatchName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Thunderstore)' == '1'">
    <DefineConstants>$(DefineConstants);THUNDERSTORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="$(AssemblyName.EndsWith('Runtime'))">
    <PackageReference Remove="Lib.Harmony" />
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="$(MSBuildThisFileDirectory)Common\MelonEntry.cs" Link="Common\MelonEntry.cs" />
    <AssemblyAttribute Include="MelonLoader.MelonInfoAttribute">
      <_Parameter1>typeof(MimesisPatches.MelonEntry)</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(PatchName)</_Parameter2>
      <_Parameter3>$(Version)</_Parameter3>
      <_Parameter4>medovanx</_Parameter4>
      <_Parameter5>https://github.com/medovanx/mimesis-patches</_Parameter5>
    </AssemblyAttribute>
    <AssemblyAttribute Include="MelonLoader.MelonGameAttribute">
      <_Parameter1>ReLUGames</_Parameter1>
      <_Parameter2>MIMESIS</_Parameter2>
    </AssemblyAttribute>
    <!-- AI disclosure, as Thunderstore asks (wiki: "LLMs and AI-generated files"). -->
    <AssemblyMetadata Include="AI_Assisted_Creation" Value="This assembly was partially or fully created with the assistance of Generative AI (code, refactoring and documentation)." />
    <AssemblyMetadata Include="AI_Model_Vendor" Value="Anthropic (Claude)" />
    <!-- Each patch applies its Harmony patches itself, in Plugin.Init at Hub.Awake; don't let MelonLoader do it too. -->
    <AssemblyAttribute Include="MelonLoader.HarmonyDontPatchAllAttribute" />
  </ItemGroup>
</Project>
